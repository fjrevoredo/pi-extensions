#!/usr/bin/env bash
# Enable once per clone with:
#   git config core.hooksPath .githooks
#
# Runs the mechanical checks from docs/PI_EXTENSIONS_BEST_PRACTICES.md section 13.
# Use `git commit --no-verify` for a deliberate WIP commit.
#
# This hook defines no command of its own. It calls the npm scripts, and so does
# .github/workflows/ci.yml, so the two cannot drift apart — there is nothing in
# either file to drift. check-hook-parity.sh asserts that they stay call sites.
set -euo pipefail

npm run typecheck
npm test
npm run lint
npm run changelog
